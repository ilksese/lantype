{
  "$schema": "https://raw.githubusercontent.com/nexxeln/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "LanType",
  "version": "0.1.0",
  "identifier": "com.lantype.desktop",
  "build": {
    "beforeDevCommand": "npm run build:phone && npm run dev:web",
    "beforeBuildCommand": "npm run build:phone",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../web"
  },
  "bundle": {
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LanType",
        "width": 320,
        "height": 520,
        "center": true,
        "decorations": true,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
